# Server Port & Environment
PORT=3000
NODE_ENV=production

# Persistent Storage Directory (Set to /data on Railway when mounting a Volume)
# DATA_DIR=/data

# OpenWA Self-Hosted Gateway (Optional - can also be configured in the CRM Web UI)
OPENWA_ENABLED=false
OPENWA_SERVER_URL=http://localhost:2785/api
OPENWA_API_KEY=
OPENWA_SESSION_ID=default

# Official Meta WhatsApp Cloud API & Webhook Security (Optional)
WHATSAPP_VERIFY_TOKEN=leadsquared_crm_verify_token
WHATSAPP_APP_SECRET=

# Optional Webhook URL override for OpenWA -> CRM events
# CRM_WEBHOOK_URL=http://127.0.0.1:3000/api/webhooks/whatsapp
